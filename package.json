{
  "name": "hdcx",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 docusaurus start  --config dev.config.js --host 0.0.0.0 --no-open",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 docusaurus build",
    "check": "node scripts/check-mdx.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "rag:setup": "node rag/scripts/setup-index.mjs",
    "rag:chunks": "node rag/scripts/build-chunks.mjs",
    "rag:index": "node rag/scripts/index.mjs",
    "rag:deploy": "pnpm --dir workers/rag-api --ignore-workspace exec wrangler deploy",
    "rag:update": "pnpm rag:index && pnpm rag:deploy",
    "fayu:install": "pnpm --dir workers/fayu-api --ignore-workspace install",
    "fayu:import": "node workers/fayu-api/scripts/import.mjs",
    "fayu:dev": "pnpm --dir workers/fayu-api --ignore-workspace exec wrangler dev",
    "fayu:deploy": "pnpm --dir workers/fayu-api --ignore-workspace exec wrangler deploy",
    "media:install": "pnpm --dir workers/media-proxy --ignore-workspace install",
    "media:dev": "pnpm --dir workers/media-proxy --ignore-workspace exec wrangler dev",
    "media:deploy": "pnpm --dir workers/media-proxy --ignore-workspace exec wrangler deploy"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^1.2.1",
    "jszip": "^3.10.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "unist-util-visit": "^5.1.0",
    "use-local-storage-state": "^19.5.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@docusaurus/types": "^3.10.2",
    "cross-env": "^10.1.0",
    "docusaurus-mdx-checker": "3.0.0",
    "node-html-parser": "^9.0.6"
  }
}
