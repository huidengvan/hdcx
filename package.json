{
  "name": "hdcx",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 docusaurus start  --config dev.config.js --host 0.0.0.0 --no-open",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 docusaurus build",
    "check": "npx docusaurus-mdx-checker",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^1.2.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "unist-util-visit": "^5.1.0",
    "use-local-storage-state": "^19.5.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@docusaurus/types": "^3.10.2",
    "cross-env": "^10.1.0"
  }
}